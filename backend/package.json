{
  "name": "phone-store-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express and MongoDB API for a smartphone store",
  "main": "server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start-local.ps1",
    "build": "node --check server.js",
    "lint": "eslint server.js src test",
    "test": "node --test",
    "format": "prettier --write \"server.js\" \"src/**/*.js\" \"test/**/*.js\" \"eslint.config.cjs\" \"package.json\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "nodemon": "^3.1.9",
    "prettier": "^3.9.10"
  }
}
